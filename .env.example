# megajam-kit API keys. Copy to .env and fill in. .env is gitignored and must never be committed.
# Scripts load it with: node --env-file=<kit>/.env ...

# Concept images, Gemini (tools/gen/image.js --provider gemini). https://aistudio.google.com/apikey
# The Google Cloud project behind it needs billing enabled: the image models have no free tier.
GEMINI_API_KEY=

# Concept images, OpenAI (tools/gen/image.js --provider openai). https://platform.openai.com/api-keys
# The organisation needs API credits.
OPENAI_API_KEY=

# Image-to-3D, retopology, rigging, FBX export via the Tripo CLI. https://platform.tripo3d.ai (international site)
# Prepaid API credits (1 credit = 0.01 USD).
TRIPO_API_KEY=
TRIPO_REGION=ov

# Sound effects, music and voice, ElevenLabs (tools/gen/audio.js). https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=
