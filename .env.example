# megajam-kit API keys. Copy to .env and fill in. .env is gitignored and must never be committed.
# Scripts in this kit load it automatically.

# Concept images, Gemini. https://aistudio.google.com/apikey
# The Google Cloud project behind it needs billing enabled: the image models have no free tier.
GEMINI_API_KEY=

# Concept images, OpenAI. https://platform.openai.com/api-keys
# The organisation needs API credits.
OPENAI_API_KEY=

# Image-to-3D, retopology, rigging, FBX export via the Tripo CLI. https://platform.tripo3d.ai (international site)
# Prepaid API credits (1 credit = 0.01 USD).
TRIPO_API_KEY=
# Read by the Tripo CLI itself (no kit code uses it).
TRIPO_REGION=ov

# Sound effects, music and voice, ElevenLabs. https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=

# Text-to-motion animation, Uthana. https://uthana.com (pay as you go; see PIPELINE.md "Motion: Uthana")
UTHANA_API_KEY=

# Optional: Meshy, a fallback for models when the director isn't satisfied with Tripo's result. https://www.meshy.ai
# (API docs: https://docs.meshy.ai). Most fallback use is the web app: export the model and run it through the kit's
# Blender prep and import by hand. A key is only needed to script it, and API access needs a paid Meshy plan.
# No kit script uses it yet.
MESHY_API_KEY=

# Optional: Hyper3D Rodin (image/text-to-3D). Jam perk: a Rodin Business subscription with 208 credits (code in the
# jam's partner email; redeem at https://hyper3d.ai > Wallet > Code Redemption by Nov 16). A key is only needed to
# script it (create one in your Hyper3D account's API settings); the web app needs none: generate there, export FBX or
# GLB, then `node gen\asset.ts --model <file> --name <Name>` (PIPELINE.md). No kit script uses the key yet.
# Listing Rodin under "Tools you used" on the submission form is what counts for Hyper3D's prize pool.
HYPER3D_API_KEY=

# Optional: fal (image, video, audio and 3D models through one API). Jam perk: $30 of credits (code in the partner
# email; redeem at https://fal.ai by Nov 30). Keys: https://fal.ai/dashboard/keys. No kit script uses it yet.
FAL_KEY=

# No key needed (web apps, the director's accounts): PBRgen (tileable PBR materials, free Nov 7-15: import the maps
# with `node gen\unreal\materials.ts apply`), WeLoveIndies (sound and music, non-commercial licence: log what is used
# in SOURCED_ASSETS.md). The jam's Claude perk is API credit on platform.claude.com, separate from Claude Code.

# Hugging Face read token, for UE 5.9's Kimodo animation generator (SETUP.md 10b). https://huggingface.co/settings/tokens
# The account needs access to meta-llama/Meta-Llama-3-8B-Instruct. Kimodo doesn't read this file: run
# `node gen\hf_token.ts` once to copy it into Hugging Face's own token file, which Kimodo reads.
HUGGINGFACE_ACCESS_TOKEN=

# The Unreal project the generators write into (<project>\Generated\...). Change per project.
# Generated files never go in the kit.
MEGAJAM_PROJECT=
