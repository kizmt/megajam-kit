# megajam-kit API keys. Copy to .env and fill in. .env is gitignored and must never be committed.
# Scripts in this kit load it automatically.

# Concept images, Gemini. https://aistudio.google.com/apikey
# The Google Cloud project behind it needs billing enabled: the image models have no free tier.
GEMINI_API_KEY=

# Concept images, OpenAI. https://platform.openai.com/api-keys
# The organisation needs API credits.
OPENAI_API_KEY=

# Image-to-3D, retopology, rigging, FBX export via the Tripo CLI. https://platform.tripo3d.ai (international site)
# Prepaid API credits (1 credit = 0.01 USD).
TRIPO_API_KEY=
# Read by the Tripo CLI itself (no kit code uses it).
TRIPO_REGION=ov

# Sound effects, music and voice, ElevenLabs. https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=

# Text-to-motion animation, Uthana. https://uthana.com (pay as you go; see PIPELINE.md "Motion: Uthana")
UTHANA_API_KEY=

# Optional: Meshy, a fallback for models when the director isn't satisfied with Tripo's result. https://www.meshy.ai
# (API docs: https://docs.meshy.ai). Most fallback use is the web app: export the model and run it through the kit's
# Blender prep and import by hand. A key is only needed to script it, and API access needs a paid Meshy plan.
# No kit script uses it yet.
MESHY_API_KEY=

# The Unreal project the generators write into (<project>\Generated\...). Change per project.
# Generated files never go in the kit.
MEGAJAM_PROJECT=
